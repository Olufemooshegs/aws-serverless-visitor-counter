*.tfvars
*.tfvars.json
!*.tfvars.example

# ── Lambda build artifacts ───────────────────────────────
**/build/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# ── AWS credentials (paranoia) ───────────────────────────
.aws/
credentials

# ── OS / Editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Logs ─────────────────────────────────────────────────
*.log
